# Business Central/AL generated artifacts
.alpackages/
.altestrunner/
.alcache/
.snapshots/
.netpackages/

# Build outputs
*.app

# Common local/tooling artifacts
.vscode/.alcache/
.vscode/*.code-workspace

# OS artifacts
Thumbs.db
desktop.ini
*.xlsx
*.xls
*.csv
*.docx
*.pdf


# Libreta del modo RAD: su lista "Removed" dropea tablas con sus datos al publicar.
# Es caché local, se regenera sola, y versionada reparte una foto desactualizada.
.vscode/rad.json

# Obsidian: estado local de la interfaz (el contenido del vault sí se versiona)
Vault/.obsidian/workspace*.json
Vault/.obsidian/cache
Vault/.trash/

# Datos extraídos de la base real. Hacen a las pruebas, no al proyecto, y traen legajos,
# nombres y CUIL. Van acá por el mismo motivo que los .xlsx y .csv de arriba, con una razón
# de más: el historial de git no se deshace. Borrar el archivo en un commit posterior no lo
# saca del historial, y que el repo sea privado no cambia eso.
*.tsv
*.msg

# ConfigPackage de RapidStart: 355 MB descomprimidos, o sea datos de tablas y no un esquema.
# Si hiciera falta versionar configuración, exportarla filtrada y sin datos de empleados.
*.rapidstart

# Artefactos locales: el perfil de CPU se regenera corriendo el profiler, y el redistribuible
# de Oracle se restaura desde su paquete.
*.alcpuprofile
*.dll
