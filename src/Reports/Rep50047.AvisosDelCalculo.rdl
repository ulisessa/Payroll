          <Textbox Name="TxtSubtitulo">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!NoEmpleado.Value, "DataSet_Result") &amp; "  " &amp; First(Fields!NombreEmpleado.Value, "DataSet_Result") &amp; "   |   " &amp; First(Fields!NoLiquidacion.Value, "DataSet_Result") &amp; "   |   Período " &amp; First(Fields!CodPeriodo.Value, "DataSet_Result") &amp; "   |   " &amp; First(Fields!CodTipoLiq.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!TotalAvisos.Value, "DataSet_Result") &amp; " aviso(s)   |   Registro N° " &amp; First(Fields!NoRegistro.Value, "DataSet_Result") &amp; "   |   " &amp; Format(First(Fields!FechaHoraInicio.Value, "DataSet_Result"), "dd/MM/yyyy HH:mm")</Value>
                    <Style>
                      <FontSize>8pt</FontSize>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.75cm</Top>
            <Left>0cm</Left>
            <Height>0.95cm</Height>
            <Width>18cm</Width>
            <Style>
