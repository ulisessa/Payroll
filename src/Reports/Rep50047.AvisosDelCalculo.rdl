        <ReportItems>
          <Textbox Name="TxtTitulo">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!TituloInforme.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontSize>13pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>0.7cm</Height>
            <Width>18cm</Width>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingTop>2pt</PaddingTop>
            </Style>
