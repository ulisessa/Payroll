                                <Border>
                                  <Style>Solid</Style>
                                  <Width>0.5pt</Width>
                                </Border>
                              </Style>
                            </Textbox>
                            <!-- Título gráfico -->
                            <Textbox Name="TxtGraficoTitulo">
                              <Top>0cm</Top>
                              <Left>10cm</Left>
                              <Width>9cm</Width>
                              <Height>0.45cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Costo total empleador</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <!-- Gráfico de torta -->
                            <Chart Name="ChartCostoEmpleador">
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                              </Style>
                              <Top>0.5cm</Top>
                              <Left>10cm</Left>
                              <Width>9cm</Width>
                              <Height>5cm</Height>
                              <DataSetName>DataSet_Result</DataSetName>
                              <ChartSeriesHierarchy>
                                <ChartMembers>
                                  <ChartMember>
                                    <Label>Importe</Label>
                                  </ChartMember>
                                </ChartMembers>
                              </ChartSeriesHierarchy>
                              <ChartCategoryHierarchy>
                                <ChartMembers>
                                  <ChartMember>
                                    <Group Name="GrpPieCategoria">
                                      <GroupExpressions>
                                        <GroupExpression>=IIF(Fields!LinEsHaber.Value AND Fields!LinTipoConcepto.Value = 0, "Hab. Remunerativo", IIF(Fields!LinEsHaber.Value AND Fields!LinTipoConcepto.Value = 1, "Hab. No Remunerativo", IIF(Fields!LinEsDescuento.Value, "Descuentos Trabajador", IIF(Fields!LinEsContrib.Value, "Contrib. Patronales", ""))))</GroupExpression>
                                      </GroupExpressions>
                                      <Filters>
                                        <Filter>
                                          <FilterExpression>=Fields!LinCodConcepto.Value</FilterExpression>
                                          <Operator>NotEqual</Operator>
                                          <FilterValues>
                                            <FilterValue></FilterValue>
                                          </FilterValues>
                                        </Filter>
                                        <Filter>
                                          <FilterExpression>=IIF(Fields!LinEsHaber.Value OR Fields!LinEsDescuento.Value OR Fields!LinEsContrib.Value, 1, 0)</FilterExpression>
                                          <Operator>Equal</Operator>
                                          <FilterValues>
                                            <FilterValue>=1</FilterValue>
                                          </FilterValues>
                                        </Filter>
                                      </Filters>
                                    </Group>
                                    <Label>=IIF(Fields!LinEsHaber.Value AND Fields!LinTipoConcepto.Value = 0, "Hab. Remunerativo", IIF(Fields!LinEsHaber.Value AND Fields!LinTipoConcepto.Value = 1, "Hab. No Remunerativo", IIF(Fields!LinEsDescuento.Value, "Descuentos Trabajador", IIF(Fields!LinEsContrib.Value, "Contrib. Patronales", ""))))</Label>
                                  </ChartMember>
                                </ChartMembers>
                              </ChartCategoryHierarchy>
                              <ChartData>
                                <ChartSeriesCollection>
                                  <ChartSeries Name="Series1">
                                    <ChartDataPoints>
                                      <ChartDataPoint>
                                        <ChartDataPointValues>
                                          <Y>=Sum(Fields!LinImporte.Value)</Y>
                                        </ChartDataPointValues>
                                        <ChartDataLabel>
                                          <Label>=Format(Sum(Fields!LinImporte.Value) / Sum(Fields!LinImporte.Value, "GrpLiquidacion") * 100, "0") &amp; "%"</Label>
                                          <Style>
                                            <FontSize>7pt</FontSize>
                                            <FontWeight>Bold</FontWeight>
                                          </Style>
                                        </ChartDataLabel>
                                      </ChartDataPoint>
                                    </ChartDataPoints>
                                    <Type>Shape</Type>
                                    <Subtype>Pie</Subtype>
                                    <LegendName>Legend</LegendName>
                                    <ChartAreaName>Default</ChartAreaName>
                                  </ChartSeries>
                                </ChartSeriesCollection>
                              </ChartData>
                              <ChartAreas>
                                <ChartArea Name="Default">
                                  <ChartCategoryAxes>
                                    <ChartAxis Name="Category">
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </ChartAxis>
                                  </ChartCategoryAxes>
                                  <ChartValueAxes>
                                    <ChartAxis Name="Value"></ChartAxis>
                                  </ChartValueAxes>
                                  <Style>
                                    <Border>
                                      <Style>None</Style>
                                    </Border>
                                  </Style>
                                </ChartArea>
                              </ChartAreas>
                              <ChartLegends>
                                <ChartLegend Name="Legend">
                                  <Position>BottomCenter</Position>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                  </Style>
                                </ChartLegend>
                              </ChartLegends>
                            </Chart>
                          </ReportItems>
                          <Style>
                            <TopBorder>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                              <Color>LightGray</Color>
                            </TopBorder>
                          </Style>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- ═══ ROW 13: Nota legal ═══ -->
                <TablixRow>
                  <Height>0.45cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtNota">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Nota: La seguridad social del empleador incluye SIPA, Fondo Nacional de Empleo y Asignaciones Familiares</Value>
                                  <Style>
                                    <FontSize>6pt</FontSize>
                                    <Color>Gray</Color>
                                    <FontStyle>Italic</FontStyle>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingLeft>3pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                            <TopBorder>
                              <Style>Solid</Style>
                              <Width>0.3pt</Width>
                              <Color>LightGray</Color>
                            </TopBorder>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- ═══ ROW 14: Firmas ═══ -->
                <TablixRow>
                  <Height>1.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectFirmasV2">
                          <ReportItems>
                            <Textbox Name="TxtFirmaEmpV2">
                              <Left>1cm</Left>
                              <Top>1cm</Top>
                              <Width>6cm</Width>
                              <Height>0.4cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Firma y aclaración del empleado</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                        <Color>Gray</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <TopBorder>
                                  <Style>Solid</Style>
                                  <Width>0.5pt</Width>
                                </TopBorder>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtFirmaEmprV2">
                              <Left>12cm</Left>
                              <Top>1cm</Top>
                              <Width>6cm</Width>
                              <Height>0.4cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Firma del empleador</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                        <Color>Gray</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <TopBorder>
                                  <Style>Solid</Style>
                                  <Width>0.5pt</Width>
                                </TopBorder>
                              </Style>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="GrpLiquidacion">
                    <GroupExpressions>
                      <GroupExpression>=Fields!LiqNo.Value</GroupExpression>
