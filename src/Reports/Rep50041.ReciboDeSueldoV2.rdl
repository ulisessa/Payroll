<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="TablixReciboV2">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>19cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- ═══ ROW 1: Encabezado empresa ═══ -->
                <TablixRow>
                  <Height>1.2cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectEmpresa">
                          <ReportItems>
                            <Textbox Name="TxtEmpresaLabel">
                              <Top>0cm</Top>
                              <Left>0cm</Left>
                              <Width>19cm</Width>
                              <Height>0.35cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>EMPRESA</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingLeft>3pt</PaddingLeft>
                                <PaddingTop>2pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtEmpresaNombre">
                              <Top>0.35cm</Top>
                              <Left>0cm</Left>
                              <Width>14cm</Width>
                              <Height>0.45cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyName.Value)</Value>
                                      <Style>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingLeft>3pt</PaddingLeft>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtEmpresaCUIT">
                              <Top>0.35cm</Top>
                              <Left>14cm</Left>
                              <Width>5cm</Width>
                              <Height>0.45cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="C.U.I.T. EMPRESA: " &amp; First(Fields!CompanyCUIT.Value)</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingRight>3pt</PaddingRight>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtEmpresaDomicilio">
                              <Top>0.8cm</Top>
                              <Left>0cm</Left>
                              <Width>19cm</Width>
                              <Height>0.4cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyAddress.Value)</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                        <Color>Gray</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingLeft>3pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </ReportItems>
                          <Style>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Width>1pt</Width>
                            </BottomBorder>
                          </Style>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
