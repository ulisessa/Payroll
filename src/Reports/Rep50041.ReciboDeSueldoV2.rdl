                                      <GroupExpressions>
                                        <GroupExpression>=IIF(Fields!LinEsPrimeraLinea.Value, "Sueldo Neto", IIF(Fields!LinGrupoCostoNum.Value = 1, "Sindical", IIF(Fields!LinGrupoCostoNum.Value = 2, "Seguridad Social", IIF(Fields!LinGrupoCostoNum.Value = 3, "Obra Social", IIF(Fields!LinGrupoCostoNum.Value = 4, "INSSJP", IIF(Fields!LinGrupoCostoNum.Value = 5, "ART", IIF(Fields!LinGrupoCostoNum.Value = 6, "SCVO", "")))))))</GroupExpression>
