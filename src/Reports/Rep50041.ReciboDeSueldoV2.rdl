                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectDetalle">
                          <ReportItems>
                            <Textbox Name="TxtDetalleTitulo">
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Detalle de la composición del costo laboral</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <TextDecoration>Underline</TextDecoration>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Height>0.45cm</Height>
                              <Width>10cm</Width>
                              <Style>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <!-- Col 1: Sindical -->
                            <Textbox Name="TxtCostoSindLbl">
                              <Top>0.5cm</Top>
                              <Left>0cm</Left>
                              <Width>3cm</Width>
                              <Height>0.9cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="Total Costo Sindical:" &amp; Chr(10) &amp; "  Empleador" &amp; Chr(10) &amp; "  Trabajador"</Value>
                                      <Style>
                                        <FontSize>6.5pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtCostoSindVal">
                              <Top>0.5cm</Top>
                              <Left>3cm</Left>
                              <Width>2cm</Width>
                              <Height>0.9cm</Height>
                              <Paragraphs>
                                <Paragraph>
