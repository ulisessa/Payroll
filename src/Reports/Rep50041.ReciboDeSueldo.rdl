<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>a1b2c3d4-e5f6-7890-abcd-ef1234567890</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="TablixRecibo">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>18cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>1.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectHeader">
                          <ReportItems>
                            <Textbox Name="TxtCompany">
                              <Top>0.45cm</Top>
                              <Left>0cm</Left>
                              <Width>12.5cm</Width>
                              <Height>0.65cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=First(Fields!CompanyName.Value)</Value>
                                      <Style>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style />
                            </Textbox>
                            <Image Name="ImgLogo">
                              <Source>External</Source>
                              <Value>=First(Fields!CompanyLogoPath.Value)</Value>
                              <Sizing>FitProportional</Sizing>
                              <Visibility>
                                <Hidden>=First(Fields!CompanyLogoPath.Value) = ""</Hidden>
                              </Visibility>
                              <Top>0cm</Top>
                              <Left>13cm</Left>
                              <Width>5cm</Width>
                              <Height>1.5cm</Height>
                              <Style />
                            </Image>
                          </ReportItems>
                          <Style>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Width>1pt</Width>
                            </BottomBorder>
                          </Style>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.45cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtCompanyAddr">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!CompanyAddress.Value) &amp; "  |  CUIT: " &amp; First(Fields!CompanyCUIT.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Color>Gray</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.8cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtTitle">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="RECIBO DE HABERES — " &amp; First(Fields!PeriodoDesc.Value) &amp; "  (" &amp; First(Fields!LiqTipoLiq.Value) &amp; ")"</Value>
                                  <Style>
                                    <FontSize>12pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>LightSteelBlue</BackgroundColor>
                            <PaddingTop>3pt</PaddingTop>
                            <PaddingBottom>3pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtEmpNo">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Legajo: " &amp; First(Fields!LiqEmployeeNo.Value) &amp; "   " &amp; First(Fields!LiqEmployeeName.Value)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtEmpData">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="CUIL: " &amp; First(Fields!EmpCUIL.Value) &amp; "   Domicilio: " &amp; First(Fields!EmpDomicilio.Value) &amp; "   Ingreso: " &amp; First(Fields!EmpFechaIngreso.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtCCT">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="CCT: " &amp; First(Fields!LiqConvenioDesc.Value) &amp; IIF(First(Fields!LiqCategoriaDesc.Value) &lt;&gt; "", "   Categoría: " &amp; First(Fields!LiqCategoriaDesc.Value), "") &amp; IIF(First(Fields!LiqNoProyecto.Value) &lt;&gt; "", "   Marea: " &amp; First(Fields!LiqNoProyecto.Value), "")</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingBottom>3pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtPeriodDates">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Período: " &amp; First(Fields!PeriodoFechaDesde.Value) &amp; " al " &amp; First(Fields!PeriodoFechaHasta.Value) &amp; "   Fecha de liquidación: " &amp; First(Fields!LiqFechaLiq.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Color>Gray</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>4pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectConceptHdr">
                          <ReportItems>
                            <Textbox Name="HdrConcepto">
                              <Left>0cm</Left>
                              <Top>0cm</Top>
                              <Width>7cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>CONCEPTO</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>SteelBlue</BackgroundColor>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <Textbox Name="HdrUnidades">
                              <Left>7cm</Left>
                              <Top>0cm</Top>
                              <Width>3cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>UNIDADES</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>SteelBlue</BackgroundColor>
                                <PaddingRight>4pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <Textbox Name="HdrHaberes">
                              <Left>10cm</Left>
                              <Top>0cm</Top>
                              <Width>4cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>HABERES</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>SteelBlue</BackgroundColor>
                                <PaddingRight>4pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <Textbox Name="HdrDescuentos">
                              <Left>14cm</Left>
                              <Top>0cm</Top>
                              <Width>4cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>DESCUENTOS</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>SteelBlue</BackgroundColor>
                                <PaddingRight>4pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                              </Style>
                            </Textbox>
                          </ReportItems>
                          <Style>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                          </Style>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Tablix Name="TablixConceptos">
                          <TablixBody>
                            <TablixColumns>
                              <TablixColumn>
                                <Width>7cm</Width>
                              </TablixColumn>
                              <TablixColumn>
                                <Width>3cm</Width>
                              </TablixColumn>
                              <TablixColumn>
                                <Width>4cm</Width>
                              </TablixColumn>
                              <TablixColumn>
                                <Width>4cm</Width>
                              </TablixColumn>
                            </TablixColumns>
                            <TablixRows>
                              <TablixRow>
                                <Height>0.5cm</Height>
                                <TablixCells>
                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="TxtLinNombre">
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=Fields!LinNombre.Value</Value>
                                                <Style>
                                                  <FontSize>8pt</FontSize>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                          </Paragraph>
                                        </Paragraphs>
                                        <Style>
                                          <PaddingLeft>4pt</PaddingLeft>
                                          <PaddingTop>2pt</PaddingTop>
                                        </Style>
                                      </Textbox>
                                    </CellContents>
                                  </TablixCell>
                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="TxtLinUnidades">
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=IIF(Fields!LinCantidad.Value &lt;&gt; 0, Format(Fields!LinCantidad.Value, "G") &amp; IIF(Fields!LinUnidadCantidad.Value &lt;&gt; "", " " &amp; Fields!LinUnidadCantidad.Value, ""), "")</Value>
                                                <Style>
                                                  <FontSize>8pt</FontSize>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                            <Style>
                                              <TextAlign>Right</TextAlign>
                                            </Style>
                                          </Paragraph>
                                        </Paragraphs>
                                        <Style>
                                          <PaddingRight>4pt</PaddingRight>
                                          <PaddingTop>2pt</PaddingTop>
                                        </Style>
                                      </Textbox>
                                    </CellContents>
                                  </TablixCell>
                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="TxtLinHaber">
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=IIF(Fields!LinEsHaber.Value, Format(Fields!LinImporte.Value, "N2"), "")</Value>
                                                <Style>
                                                  <FontSize>8pt</FontSize>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                            <Style>
                                              <TextAlign>Right</TextAlign>
                                            </Style>
                                          </Paragraph>
                                        </Paragraphs>
                                        <Style>
                                          <PaddingRight>4pt</PaddingRight>
                                          <PaddingTop>2pt</PaddingTop>
                                        </Style>
                                      </Textbox>
                                    </CellContents>
                                  </TablixCell>
                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="TxtLinDescuento">
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=IIF(Fields!LinEsDescuento.Value, Format(Fields!LinImporte.Value, "N2"), "")</Value>
                                                <Style>
                                                  <FontSize>8pt</FontSize>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                            <Style>
                                              <TextAlign>Right</TextAlign>
                                            </Style>
                                          </Paragraph>
                                        </Paragraphs>
                                        <Style>
                                          <PaddingRight>4pt</PaddingRight>
                                          <PaddingTop>2pt</PaddingTop>
                                        </Style>
                                      </Textbox>
                                    </CellContents>
                                  </TablixCell>
                                </TablixCells>
                              </TablixRow>
                            </TablixRows>
                          </TablixBody>
                          <TablixRowHierarchy>
                            <TablixMembers>
                              <TablixMember>
                                <Group Name="GrpConceptos">
                                  <GroupExpressions>
                                    <GroupExpression>=Fields!LinCodConcepto.Value</GroupExpression>
                                  </GroupExpressions>
                                  <Filters>
                                    <Filter>
                                      <FilterExpression>=Fields!LinCodConcepto.Value</FilterExpression>
                                      <Operator>NotEqual</Operator>
                                      <FilterValues>
                                        <FilterValue></FilterValue>
                                      </FilterValues>
                                    </Filter>
                                    <Filter>
                                      <FilterExpression>=IIF(Fields!LinEsHaber.Value OR Fields!LinEsDescuento.Value, 1, 0)</FilterExpression>
                                      <Operator>Equal</Operator>
                                      <FilterValues>
                                        <FilterValue>=1</FilterValue>
                                      </FilterValues>
                                    </Filter>
                                  </Filters>
                                </Group>
                                <SortExpressions>
                                  <SortExpression>
                                    <Value>=Fields!LinTipoConcepto.Value</Value>
                                  </SortExpression>
                                  <SortExpression>
                                    <Value>=Fields!LinOrden.Value</Value>
                                  </SortExpression>
                                </SortExpressions>
                              </TablixMember>
                            </TablixMembers>
                          </TablixRowHierarchy>
                          <TablixColumnHierarchy>
                            <TablixMembers>
                              <TablixMember />
                              <TablixMember />
                              <TablixMember />
                              <TablixMember />
                            </TablixMembers>
                          </TablixColumnHierarchy>
                          <DataSetName>DataSet_Result</DataSetName>
                          <Style>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                          </Style>
                        </Tablix>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.55cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectSubtotales">
                          <ReportItems>
                            <Textbox Name="TxtLblSubtot">
                              <Left>0cm</Left>
                              <Top>0cm</Top>
                              <Width>10cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>SUBTOTALES</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingTop>3pt</PaddingTop>
                                <BackgroundColor>WhiteSmoke</BackgroundColor>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtSubtotHaberes">
                              <Left>10cm</Left>
                              <Top>0cm</Top>
                              <Width>4cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Format(Sum(Fields!LinImporteHaber.Value, "GrpLiquidacion"), "N2")</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingRight>4pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <BackgroundColor>WhiteSmoke</BackgroundColor>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtSubtotDescuentos">
                              <Left>14cm</Left>
                              <Top>0cm</Top>
                              <Width>4cm</Width>
                              <Height>0.55cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Format(Sum(Fields!LinImporteDescuento.Value, "GrpLiquidacion"), "N2")</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <PaddingRight>4pt</PaddingRight>
                                <PaddingTop>3pt</PaddingTop>
                                <BackgroundColor>WhiteSmoke</BackgroundColor>
                              </Style>
                            </Textbox>
                          </ReportItems>
                          <Style>
                            <TopBorder>
                              <Style>Solid</Style>
                              <Width>1pt</Width>
                            </TopBorder>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Width>1pt</Width>
                            </BottomBorder>
                          </Style>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.8cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="RectNeto">
                          <ReportItems>
                            <Textbox Name="TxtLblNeto">
                              <Left>0cm</Left>
                              <Top>0cm</Top>
                              <Width>13cm</Width>
                              <Height>0.8cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>NETO A PAGAR</Value>
                                      <Style>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>DarkSlateBlue</BackgroundColor>
                                <PaddingLeft>6pt</PaddingLeft>
                                <PaddingTop>5pt</PaddingTop>
                              </Style>
                            </Textbox>
                            <Textbox Name="TxtNeto">
                              <Left>13cm</Left>
                              <Top>0cm</Top>
                              <Width>5cm</Width>
                              <Height>0.8cm</Height>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="$ " &amp; Format(Sum(Fields!LinImporteHaber.Value, "GrpLiquidacion") - Sum(Fields!LinImporteDescuento.Value, "GrpLiquidacion"), "N2")</Value>
                                      <Style>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <BackgroundColor>DarkSlateBlue</BackgroundColor>
                                <PaddingRight>6pt</PaddingRight>
                                <PaddingTop>4pt</PaddingTop>
                              </Style>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.45cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtContribHdr">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>APORTES PATRONALES (informativo)</Value>
                                  <Style>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>Gray</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>4pt</PaddingTop>
                            <PaddingLeft>2pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
