# Normalize text files and keep a consistent EOL strategy
* text=auto

# Source and config files should stay LF across platforms
*.al text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xlf text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Explicit binary files
*.app binary
*.xlsx binary
*.pdf binary
*.rapidstart binary
